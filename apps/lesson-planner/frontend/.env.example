# Frontend environment variables
#
# This value is baked into the Vite build. Set it in
# Vercel -> Project -> Settings -> Environment Variables for the
# Production (and Preview) environments, then redeploy.
#
# It must include the /api suffix and use HTTPS in production.
# Do NOT put secrets here — Vite exposes every VITE_* value to the browser.
VITE_API_URL=https://your-backend-host.example.com/api
