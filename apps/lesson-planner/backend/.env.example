# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=21cta

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-48-byte-secret
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI Service Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
GROQ_API_KEY=your-groq-api-key
# Support multiple Groq keys (comma-separated)
GROQ_API_KEYS=key-1,key-2
# Groq fallback models (comma-separated)
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,moonshotai/kimi-k2-instruct-0905,llama-3.1-8b-instant

# Default AI Provider (gemini or groq)
DEFAULT_AI_PROVIDER=gemini

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Service Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
ADMIN_EMAIL=admin@example.com
FRONTEND_URL=http://localhost:5173

# Redis Configuration for Job Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AI_MAX_REQUESTS=20
HELMET_HSTS_ENABLED=false # Set to true in production with SSL
HELMET_CONTENT_SECURITY_POLICY_REPORT_URI= # Optional CSP reporting endpoint

# Feature Flags for AI Agent
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_VOICE_INPUT=true
ENABLE_VOICE_OUTPUT=true

# Voice Service Configuration (for production integration)
# For Google Cloud Text-to-Speech:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/keyfile.json
# For Amazon Polly:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# Schema changes are never applied automatically at startup. Import database/schema.sql explicitly.
